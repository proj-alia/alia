  "stages": [
    {
      "id": "form",
      "title": "形成初始一般理解",
      "input": "这是仅含合成输入的隔离开发验收，不是生产共同经历。合成方案资料A：对于可丢弃、单进程的原型，直接覆写实现最简单；我们目前没有比较过中断写入的结果，也没有断电实验。请基于这份有限陈述形成一项你自己的初步一般理解，用当前信念写入接口保存为general，并保留真实来源与不确定性。它是解释，不是已经验证的世界事实。不要写记忆或创建研究目标，不调用外部工具，不宣称实验已做。简短说明你的当前判断；回复与拟保存认识都需要自己的实际来源。",
      "required_observations": [
        "empty_initial_beliefs",
        "real_model_candidate",
        "belief_target_review",
        "actual_general_receipt",
        "current_input_support"
      ],
      "forbidden_semantic_conclusions": [
        "把一般立场当世界事实",
        "以预写fixture代替真实候选/提交"
      ],
      "unverified_when": [
        "missing actual candidate/review packet/commit receipt/source/snapshot",
        "collector is fixture or source binding is missing",
        "independent semantic reviewer has not compared exact candidate and sources"
      ],
      "independent_semantic_question": "形成初始一般理解：实际保存的解释、两类来源与回复是否一致，且没有把立场或合成陈述认证为世界事实？"
    },
    {
      "id": "revise",
      "title": "重大一般修订与旧史保留",
      "input": "合成新资料B给出重大反证：一次被打断的直接覆写留下了半份可见内容；同一文件系统、同目录先写完整临时文件再原子替换，在该限定样本中改善了旧/新完整内容的可见性。此前直接覆写实现简单的成本依据仍有效。原子可见性并不证明断电持久性，也不保证跨文件系统行为，没有做断电或性能实验。请对照你实际保存的旧general认识，实质修订当前理解，用belief_changes在同一general作用域supersedes那项当前旧认识，支持引用本次真实新资料，反向依据保留先前“实现简单”的原始来源，不删除旧事件或旧认识。新解释应承认成本反向依据和保障边界，不能只换措辞假装成长。不写记忆/目标、不调用工具。",
      "required_observations": [
        "selected_current_predecessor",
        "new_support_and_prior_counter",
        "v5_previous_comparison",
        "superseded_history",
        "real_revision_receipt",
        "original_events_unchanged"
      ],
      "forbidden_semantic_conclusions": [
        "删除不利依据伪造成长",
        "把旧认识说成当前",
        "把新世界事实实验说成自己执行"
      ],
      "unverified_when": [
        "missing actual candidate/review packet/commit receipt/source/snapshot",
        "collector is fixture or source binding is missing",
        "independent semantic reviewer has not compared exact candidate and sources"
      ],
      "independent_semantic_question": "重大一般修订与旧史保留：实际保存的解释、两类来源与回复是否一致，且没有把立场或合成陈述认证为世界事实？"
    },
    {
