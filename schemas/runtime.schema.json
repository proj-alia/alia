{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alia.invalid/schemas/runtime.schema.json",
  "title": "Alia runtime v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "autonomy",
    "budgets",
    "contact",
    "memory",
    "development",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "autonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "enabled",
        "max_model_calls_per_cycle",
        "max_tool_calls_per_cycle",
        "cycle_timeout_seconds",
        "idle_check_minutes"
      ],
      "properties": {
        "mode": {
          "const": "high"
        },
        "enabled": {
          "type": "boolean"
        },
        "max_model_calls_per_cycle": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "max_tool_calls_per_cycle": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "cycle_timeout_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 120
        },
        "idle_check_minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 1440
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background_tokens_per_day",
        "total_tokens_per_day"
      ],
      "properties": {
        "background_tokens_per_day": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "total_tokens_per_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_proactive_per_day",
        "minimum_interval_hours",
        "timezone",
        "quiet_start",
        "quiet_end"
      ],
      "properties": {
        "max_proactive_per_day": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "minimum_interval_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "quiet_start": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "quiet_end": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_sources",
        "explicit_deletion",
        "ordinary_forgetting"
      ],
      "properties": {
        "require_sources": {
          "const": true
        },
        "explicit_deletion": {
          "const": "source_and_derivatives"
        },
        "ordinary_forgetting": {
          "const": "lower_retrieval_priority"
        }
      }
    },
    "development": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_value_change",
        "require_evidence",
        "preserve_revisions",
        "protected_targets"
      ],
      "properties": {
        "allow_value_change": {
          "const": true
        },
        "require_evidence": {
          "const": true
        },
        "preserve_revisions": {
          "const": true
        },
        "protected_targets": {
          "const": [
            "identity_anchor",
            "runtime_policy",
            "permissions"
          ]
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "allowed_web_hosts",
        "self_grant_permissions"
      ],
      "properties": {
        "enabled": {
          "type": "array",
          "items": {
            "enum": [
              "memory.search",
              "documents.read",
              "notes.write",
              "web.read_allowed"
            ]
          },
          "minItems": 0,
          "maxItems": 4,
          "uniqueItems": true
        },
        "allowed_web_hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 253,
            "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "self_grant_permissions": {
          "const": false
        }
      }
    }
  }
}
