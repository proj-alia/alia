{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "verdict",
          "reason",
          "evidence_ids"
        ],
        "properties": {
          "target": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "reply"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "index"
                ],
                "properties": {
                  "kind": {
                    "const": "memory"
                  },
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 5
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "index"
                ],
                "properties": {
                  "kind": {
                    "const": "person_assertion"
                  },
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 5
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "index"
                ],
                "properties": {
                  "kind": {
                    "const": "belief"
                  },
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "index"
                ],
                "properties": {
                  "kind": {
                    "const": "autobiography"
                  },
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "index"
                ],
                "properties": {
                  "kind": {
                    "const": "appraisal"
                  },
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 0
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "index"
                ],
                "properties": {
                  "kind": {
                    "const": "attitude"
                  },
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "index"
                ],
                "properties": {
                  "kind": {
                    "const": "relationship"
                  },
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "development"
                  }
                }
              }
            ]
          },
          "verdict": {
            "enum": [
              "supported",
              "unsupported",
              "uncertain"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "evidence_ids": {
            "type": "array",
            "maxItems": 41,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    }
  }
}
