{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alia.invalid/schemas/privacy-operation.schema.json",
  "title": "Alia deletion receipt and authenticated progress v1",
  "oneOf": [
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/progress"
    }
  ],
  "$defs": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "individual_id",
        "operation_id",
        "target_id",
        "state_version",
        "privacy_epoch",
        "status"
      ],
      "properties": {
        "individual_id": {
          "type": "string",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "operation_id": {
          "type": "string",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "target_id": {
          "type": "string",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "state_version": {
          "type": "integer",
          "minimum": 1
        },
        "privacy_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "blocked",
            "purging",
            "retry_pending",
            "completed"
          ]
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "individual_id",
        "operation_id",
        "target_id",
        "state_version",
        "privacy_epoch",
        "status",
        "observed_at",
        "last_error"
      ],
      "properties": {
        "individual_id": {
          "type": "string",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "operation_id": {
          "type": "string",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "target_id": {
          "type": "string",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "state_version": {
          "type": "integer",
          "minimum": 1
        },
        "privacy_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "blocked",
            "purging",
            "retry_pending",
            "completed"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_error": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,79}$"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "last_error": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
